    "deploy:smallscope": "node integrations/smallscope/deploy.cjs",
    "test:smallscope": "node test-smallscope-relay.cjs && node integrations/smallscope/test.cjs",
    "test:tank": "node test-tank.cjs && node test-tank-touch.cjs && node test-tank-audio.cjs",
    "test:runner": "node test-runner.cjs && node test-runner-art.cjs",
    "test:sky": "node test-sky.cjs && node test-sky-render.mjs",
