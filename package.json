    "express-rate-limit": "^8.7.1",
    "multer": "^2.4.0",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "three": "^0.186.1",
